{
    "name": "wb-tariffs-service",
    "version": "0.0.2",
    "description": "Сервис синхронизации тарифов WB (PostgreSQL + Google Sheets)",
    "author": "https://github.com/stepaRyazanoff/",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start:dev": "ts-node-dev --respawn --transpile-only --poll src/main.ts",
        "dev": "npm run dev:up",
        "dev:up": "docker compose up -d --build --remove-orphans",
        "dev:down": "docker compose down --remove-orphans",
        "dev:logs": "docker compose logs -f backend-dev",
        "dev:ps": "docker compose ps",
        "migrate:dev": "cross-env NODE_ENV=development knex migrate:latest --knexfile knexfile.cjs",
        "migrate:make": "knex migrate:make --knexfile knexfile.cjs -x ts",
        "rollback:dev": "cross-env NODE_ENV=development knex migrate:rollback --knexfile knexfile.cjs",
        "rollback:dev:all": "cross-env NODE_ENV=development knex migrate:rollback --all --knexfile knexfile.cjs",
        "lint": "eslint \"{src}/**/*.ts\" --fix",
        "lint:check": "eslint \"src/**/*.ts\" --max-warnings=0",
        "prettier": "prettier --write .",
        "format:check": "prettier . --check",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.3",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.3",
        "@nestjs/platform-express": "^11.1.3",
        "@nestjs/schedule": "^6.1.1",
        "cross-env": "^7.0.3",
        "googleapis": "^171.4.0",
        "joi": "^17.13.3",
        "knex": "^3.1.0",
        "pg": "^8.19.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.29.0",
        "@nestjs/cli": "^11.0.7",
        "@nestjs/schematics": "^11.0.5",
        "@types/express": "^5.0.3",
        "@types/joi": "^17.2.3",
        "@types/node": "^24.0.1",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.1",
        "globals": "^16.2.0",
        "prettier": "^3.5.3",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.34.0"
    },
    "lint-staged": {
        "**/*.{js,ts,json,md}": [
            "prettier --write"
        ]
    }
}
